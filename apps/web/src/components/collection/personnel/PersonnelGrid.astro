---
import { personnel as personnelContent } from "@bpm/data";
import Personnel from "@components/collection/personnel/Personnel.astro";
import Heading from "@components/Heading.astro";
import { getPersonnel } from "@helpers";

const dataOrder = personnelContent.data.map(person => person.name);
const personnel = (await getPersonnel()).sort((a, b) => dataOrder.indexOf(a.data.name) - dataOrder.indexOf(b.data.name));
const groups = [
  { key: "directors", heading: "Directors" },
  { key: "property-managers", heading: "Property managers" },
  { key: "accounts", heading: "Accounts" },
  { key: "administration", heading: "Administration" }
] as const;
---

{
  groups.map(group => (
    <div class="flex flex-col gap-8">
      <div class="flex items-center justify-center gap-5">
        <div class="bg-theme-border h-[2px] w-1/3 rounded" />
        <Heading as="h3" class="text-h5 sm:text-h4 whitespace-nowrap" set:text={group.heading} />
        <div class="bg-theme-border h-[2px] w-1/3 rounded" />
      </div>
      <div class="flex flex-wrap justify-center gap-8">
        {personnel
          .filter(person => person.data.group === group.key)
          .map(person => (
            <div class="w-full sm:w-[calc((100%-2.5rem)/2)] lg:w-[calc((100%-7.5rem)/4)]">
              <Personnel data={person} />
            </div>
          ))}
      </div>
    </div>
  ))
}

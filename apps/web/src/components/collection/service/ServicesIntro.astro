---
import Heading from "@components/Heading.astro";

interface Props {
  as?: "h1" | "h2";
  eyebrow?: string;
  heading: string;
  lead?: string;
}

const { as = "h2", eyebrow = "Our services", heading, lead } = Astro.props;
---

<div class="flex flex-col items-center gap-6 md:gap-10">
  <div class="max-w-10c flex flex-col gap-2 md:gap-3">
    <div class="flex items-center justify-center gap-5">
      <div class="bg-theme-brand h-[2px] w-full rounded sm:max-w-24"></div>
      <p class="subheading text-theme-brand whitespace-nowrap">{eyebrow}</p>
      <div class="bg-theme-brand h-[2px] w-full rounded sm:max-w-24"></div>
    </div>
    <Heading as={as} class="text-h3 sm:text-h2 md:text-h1 text-center">{heading}</Heading>
  </div>
  {lead && <p class="max-w-10c text-center text-lg text-balance sm:text-xl">{lead}</p>}
</div>

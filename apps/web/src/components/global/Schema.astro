---
interface Props {
  data: {
    appTitle: string;
    schemaImage: string;
    schemaLogo?: string;
  };
}

const { ...props } = Astro.props;
const { appTitle, schemaImage, schemaLogo } = props.data;
const siteURL = Astro.site?.href;

const brandName = "Belgarum Property Management";
const slogan = "Property management experts since 1989";

let schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["LocalBusiness", "RealEstateAgent"],
      "@id": "#localbusiness",
      name: brandName,
      slogan,
      url: siteURL,
      image: schemaImage,
      logo: schemaLogo || schemaImage,
      telephone: "+448002980069",
      email: "management@bpmanagement.org",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Old Manor Nursery, Kilham Lane",
        addressLocality: "Winchester",
        addressRegion: "Hampshire",
        postalCode: "SO22 5QD",
        addressCountry: "GB"
      },
      areaServed: ["Hampshire", "Sussex", "Dorset", "London", "Home Counties"],
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          opens: "09:00",
          closes: "18:00"
        }
      ],
      priceRange: "££"
    },
    {
      "@type": "WebSite",
      "@id": "#website",
      name: brandName,
      url: siteURL
    }
  ]
});
---

<script type="application/ld+json" set:html={schema} />

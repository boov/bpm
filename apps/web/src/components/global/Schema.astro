---
import { toJsonLd } from "@assets/scripts/json-ld";

interface Props {
  data: {
    schemaImage: string;
    schemaLogo?: string;
  };
}

const { ...props } = Astro.props;
const { schemaImage, schemaLogo } = props.data;
const siteURL = Astro.site?.href;

const brandName = "Belgarum Property Management";
const slogan = "Block and estate management since 1989";

const schema = toJsonLd({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "@id": `${siteURL}#localbusiness`,
      name: brandName,
      slogan,
      url: siteURL,
      image: schemaImage,
      logo: schemaLogo || schemaImage,
      telephone: "+448002980069",
      email: "management@bpmanagement.org",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Old Manor Nursery, Kilham Lane",
        addressLocality: "Winchester",
        addressRegion: "Hampshire",
        postalCode: "SO22 5QD",
        addressCountry: "GB"
      },
      areaServed: ["Hampshire", "Sussex", "Dorset", "London", "Home Counties"],
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"],
          opens: "09:00",
          closes: "17:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: "Friday",
          opens: "09:00",
          closes: "16:30"
        }
      ],
      priceRange: "££"
    },
    {
      "@type": "WebSite",
      "@id": `${siteURL}#website`,
      name: brandName,
      url: siteURL
    }
  ]
});
---

<script type="application/ld+json" set:html={schema} />

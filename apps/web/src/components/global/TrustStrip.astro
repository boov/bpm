---
import Check from "@lucide/astro/icons/check";
import { twMerge } from "tailwind-merge";
interface Props {
  class?: string;
}

const { class: classes } = Astro.props;

const items = [
  "Established in 1989",
  "Over 150 developments managed",
  "Member of The Property Ombudsman",
  "Full Member of The Property Institute"
  // "£5 million professional indemnity insurance"
];
---

<div class={twMerge("bg-theme-background-lowlight border-t-theme-border border-t p-8", classes)}>
  <ul aria-label="About Belgarum Property Management" class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm sm:justify-center">
    {
      items.map(item => (
        <li class="label flex items-center gap-3">
          <Check class="text-theme-brand size-5 shrink-0 stroke-3" aria-hidden="true" />
          {item}
        </li>
      ))
    }
  </ul>
</div>

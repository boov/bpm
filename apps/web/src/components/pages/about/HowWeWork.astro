---
import Heading from "@components/Heading.astro";
import Check from "@lucide/astro/icons/check";

const items = [
  { title: "A dedicated property manager", text: "One named contact who knows your building and inspects it regularly." },
  { title: "Money held in trust", text: "Each block or estate has its own designated trust account, separate from our own money." },
  { title: "Our own accounts team", text: "We keep the books, run credit control and produce the service charge accounts in-house." },
  { title: "Specialists where needed", text: "We use specialist firms for fire risk, asbestos, lifts and health and safety." },
  { title: "Industry-standard contracts", text: "Your management agreement sets out what we do." }
];
---

<div class="flex flex-col gap-10 lg:gap-12">
  <div class="max-w-12c mx-auto flex w-full items-center justify-center gap-5">
    <Heading as="h2" class="text-h3 lg:text-h2 whitespace-nowrap">How we work</Heading>
    <div class="bg-theme-border h-[2px] w-full rounded"></div>
  </div>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
    {
      items.map(item => (
        <div class="bg-theme-background-highlight flex flex-col gap-2 rounded-xl p-6 sm:p-8">
          <Check class="text-theme-brand mb-2 size-6 stroke-3" aria-hidden="true" />
          <Heading as="h3" class="text-h5" set:text={item.title} />
          <p set:text={item.text} />
        </div>
      ))
    }
  </div>
</div>

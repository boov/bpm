---
import Heading from "@components/Heading.astro";
import SubHeading from "@components/SubHeading.astro";

const paragraphs = [
  "Belgarum Property Management manages blocks of flats and shared estates for resident management companies (RMCs), right to manage (RTM) companies, freeholders, private landlords and developers. We don't sell or let property.",
  "We started as a family firm in 1989. Today we manage over 150 developments, from blocks of 4 flats to a 22-floor high rise, across Hampshire, Sussex, Dorset, London and the Home Counties.",
  "Our office is in Winchester, close to the M3. Every client has a dedicated property manager, available Monday to Thursday, 9am to 5pm, and Friday, 9am to 4.30pm."
];
---

<div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:gap-20 xl:gap-28">
  <div class="flex shrink-0 flex-col gap-2 md:gap-3 lg:w-80 xl:w-96">
    <div class="flex items-center gap-5">
      <SubHeading class="text-theme-action">About us</SubHeading>
      <div class="bg-theme-action h-0.5 w-20 rounded sm:w-24"></div>
    </div>
    <Heading as="h1" class="text-h2 sm:text-h1 xl:text-h0">About Belgarum Property Management</Heading>
  </div>
  <div class="flex flex-1 flex-col gap-5 lg:pt-12">
    <p class="text-lg sm:text-xl">A family firm established in 1989. Block and estate management is all we do.</p>
    <Heading as="h2" class="text-h4 lg:text-h3">Block and estate management from Winchester</Heading>
    {paragraphs.map(paragraph => <p set:text={paragraph} />)}
  </div>
</div>

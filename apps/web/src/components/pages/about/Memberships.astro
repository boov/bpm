---
import Heading from "@components/Heading.astro";
import InlineText from "@components/sections/InlineText.astro";

const items = [
  {
    lead: "The Property Institute (TPI):",
    text: "we're a Full Member of TPI, the professional body for residential managing agents. TPI was formed from ARMA and IRPM."
  },
  {
    lead: "The Property Ombudsman (TPO):",
    text: "we're a member of TPO, an independent service that settles complaints about its members. If you're unhappy with how we have dealt with a complaint, you can take it to TPO. [Read our complaints procedure](/complaints-procedure)."
  },
  { lead: "Professional indemnity insurance:", text: "we hold £5 million of cover." }
];
---

<div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between lg:gap-20 xl:gap-28">
  <div class="flex shrink-0 flex-col gap-2 md:gap-3 lg:w-80 xl:w-96">
    <Heading as="h2" class="text-h3 lg:text-h2">Who we answer to</Heading>
  </div>
  <ul class="flex flex-1 flex-col gap-6">
    {
      items.map(item => (
        <li class="md:text-lg">
          <strong class="text-theme-foreground-bold font-bold">{item.lead}</strong> <InlineText as="span" text={item.text} />
        </li>
      ))
    }
  </ul>
</div>

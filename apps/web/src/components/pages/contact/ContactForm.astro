---
import { enquiryTypes } from "@assets/scripts/enquiry-types";
import { site } from "@assets/scripts/site";
import Button from "@components/Button.astro";
import Input from "@components/Input.astro";
import InlineText from "@components/sections/InlineText.astro";
import Select from "@components/Select.astro";
import Textarea from "@components/Textarea.astro";
import CircleCheckBig from "@lucide/astro/icons/circle-check-big";
---

<form name="contact_form" data-netlify="true" netlify-honeypot="bot-field" hidden>
  <input name="form-name" />
  <input name="bot-field" />
  <input name="name" />
  <input name="email_address" />
  <input name="phone_number" />
  <input name="enquiry_type" />
  <input name="property_address" />
  <input name="client_type" />
  <input name="unit_count" />
  <input name="current_agent" />
  <input name="agreement_end" />
  <input name="development_location" />
  <input name="home_count" />
  <input name="development_stage" />
  <input name="repair_location" />
  <input name="repair_urgency" />
  <input name="seller_role" />
  <input name="solicitor_details" />
  <textarea name="enquiry_text"></textarea>
</form>

<form action="/contact/submitting/" data-netlify="true" netlify-honeypot="bot-field" method="POST" name="contact_form" x-data="contactForm()">
  <input type="hidden" name="form-name" value="contact_form" />
  <p class="hidden">
    <label>Don't fill this out if you're human: <input name="bot-field" /></label>
  </p>
  <div class="flex flex-col gap-6">
    <div class="grid gap-1">
      <label for="name">Your name</label>
      <Input id="name" minlength="2" data-error="Enter your name" required />
    </div>
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <div class="grid gap-1">
        <label for="email_address">Email address</label>
        <Input id="email_address" type="email" inputmode="email" minlength="5" data-error="Enter your email address, for example name@example.com" required />
      </div>
      <div class="grid gap-1">
        <label for="phone_number">Phone number <span class="text-theme-foreground-light font-copy ml-2 text-xs font-normal">optional</span></label>
        <Input id="phone_number" type="tel" inputmode="tel" minlength="10" maxlength="14" />
      </div>
    </div>
    <div class="grid gap-1">
      <label for="enquiry_type">What is it about?</label>
      <Select id="enquiry_type" x-model="enquiryType" options={[...enquiryTypes]} data-error="Select what your enquiry is about" required />
    </div>
    <template x-if="needsAddress">
      <div class="grid gap-1">
        <label for="property_address">Property address</label>
        <Input id="property_address" placeholder="The building or flat address" data-error="Enter the building or flat address" required />
      </div>
    </template>

    <template x-if="enquiryType === 'new-management'">
      <div class="flex flex-col gap-6 md:gap-8">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          <div class="grid gap-1">
            <label for="client_type">You are</label>
            <Select
              id="client_type"
              options={[
                { value: "", label: "‒" },
                { value: "rmc-director", label: "An RMC director" },
                { value: "rtm-director", label: "An RTM director" },
                { value: "freeholder", label: "A freeholder" },
                { value: "private-landlord", label: "A private landlord" },
                { value: "other", label: "Other" }
              ]}
              required
            />
          </div>
          <div class="grid gap-1">
            <label for="unit_count">Number of flats or homes</label>
            <Input id="unit_count" type="number" min="1" inputmode="numeric" placeholder="For example, 24" required />
          </div>
        </div>
        <div class="grid gap-1">
          <label for="current_agent">Current managing agent <span class="text-theme-foreground-light font-copy ml-2 text-xs font-normal">optional</span></label>
          <Input id="current_agent" />
        </div>
        <div class="grid gap-1">
          <label for="agreement_end"
            >When does your current management agreement end? <span class="text-theme-foreground-light font-copy ml-2 text-xs font-normal">optional</span></label
          >
          <Input id="agreement_end" />
        </div>
      </div>
    </template>

    <template x-if="enquiryType === 'new-development'">
      <div class="flex flex-col gap-6 md:gap-8">
        <div class="grid gap-1">
          <label for="development_location">Development location</label>
          <Input id="development_location" placeholder="Town or postcode" required />
        </div>
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          <div class="grid gap-1">
            <label for="home_count">Number of homes</label>
            <Input id="home_count" type="number" min="1" inputmode="numeric" placeholder="For example, 40" required />
          </div>
          <div class="grid gap-1">
            <label for="development_stage">Stage</label>
            <Select
              id="development_stage"
              options={[
                { value: "", label: "‒" },
                { value: "planning", label: "Planning" },
                { value: "under-construction", label: "Under construction" },
                { value: "selling", label: "Selling" }
              ]}
              required
            />
          </div>
        </div>
      </div>
    </template>

    <template x-if="enquiryType === 'repairs'">
      <div class="flex flex-col gap-6 md:gap-8">
        <div class="grid gap-1">
          <label for="repair_location">Where is it?</label>
          <Select
            id="repair_location"
            options={[
              { value: "", label: "‒" },
              { value: "communal-area", label: "Communal area" },
              { value: "roof-or-outside-of-the-building", label: "Roof or outside of the building" },
              { value: "inside-my-flat", label: "Inside my flat" },
              { value: "grounds-or-car-park", label: "Grounds or car park" },
              { value: "not-sure", label: "Not sure" }
            ]}
            required
          />
        </div>
        <div class="grid gap-1">
          <label for="repair_urgency">How urgent is it?</label>
          <Select
            id="repair_urgency"
            options={[
              { value: "", label: "‒" },
              { value: "urgent-it-is-causing-damage-or-a-safety-risk", label: "Urgent: it is causing damage or a safety risk" },
              { value: "not-urgent", label: "Not urgent" }
            ]}
            required
          />
        </div>
      </div>
    </template>

    <template x-if="enquiryType === 'leasehold-sale-pack'">
      <div class="flex flex-col gap-6 md:gap-8">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          <div class="grid gap-1">
            <label for="seller_role">You are</label>
            <Select
              id="seller_role"
              options={[
                { value: "", label: "‒" },
                { value: "the-seller", label: "The seller" },
                { value: "the-sellers-solicitor", label: "The seller's solicitor" },
                { value: "the-buyers-solicitor", label: "The buyer's solicitor" }
              ]}
              required
            />
          </div>
          <div class="grid gap-1">
            <label for="solicitor_details">Solicitor details <span class="text-theme-foreground-light font-copy ml-2 text-xs font-normal">optional</span></label>
            <Input id="solicitor_details" placeholder="Name and firm" />
          </div>
        </div>
        {/* A literal <a> inside <template> makes the Astro compiler leak the link past </template> */}
        <InlineText text={`Solicitors can also email [${site.solicitorEmail}](mailto:${site.solicitorEmail}).`} class="text-sm" />
      </div>
    </template>

    <div class="grid gap-1">
      <label for="enquiry_text">Your message</label>
      <Textarea
        id="enquiry_text"
        rows="4"
        x-bind:placeholder="enquiryType === 'new-management' ? 'Tell us about the building and what you need from a managing agent' : 'Tell us how we can help'"
        data-error="Enter your message"
        required
      />
    </div>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
      <Button label="Send your enquiry" type="submit" class="shrink-0 px-7 py-5 text-base">
        <CircleCheckBig slot="suffix" />
      </Button>
      <p class="text-theme-foreground-light text-sm">We use your details to reply to your enquiry. Read our <a href="/privacy-policy/" class="link">privacy policy</a>.</p>
    </div>
  </div>
</form>

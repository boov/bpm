---
import Heading from "@components/Heading.astro";
import SubHeading from "@components/SubHeading.astro";

const paragraphs = [
  "BPM was set up in 1989 with the vision of relieving others of the day-to-day work of managing a building or estate. Whilst this simple support suited many, we have seen legislation tighten a great deal, and a growing spotlight on block management.",
  "Seeing this change in the block management landscape, BPM has risen to the challenge. Our team attends CPD events, our staff have gained qualifications through The Property Institute, and we check the competence of our contractors.",
  "We are here to support our clients, and we are dedicated to proving you are in safe hands. Whatever kind of landlord you are, you now carry more liability and responsibility. We encourage you to place your trust in our team to help you navigate your obligations.",
  "Today we manage over 150 developments of every size, including blocks of 4 flats and a 22-floor high-rise, for resident management companies (RMCs), right to manage (RTM) companies, freeholders, private landlords and developers. Block and estate management is all we do: no estate agency, no lettings. Our office is in Winchester, close to the M3, and we cover Hampshire, Sussex, Dorset, London and the Home Counties."
];
---

<div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:gap-20 xl:gap-28">
  <div class="flex shrink-0 flex-col gap-2 md:gap-3 lg:max-w-1/3 lg:min-w-85">
    <div class="flex items-center gap-5">
      <SubHeading class="text-theme-brand-text">About us</SubHeading>
      <div class="bg-theme-brand h-[2px] w-20 rounded sm:w-24"></div>
    </div>
    <Heading as="h2" class="text-h3 sm:text-h2">For all your supportive management needs</Heading>
  </div>

  <div class="flex flex-1 flex-col gap-5 text-lg">
    {paragraphs.map((paragraph, index) => <p class:list={{ "text-xl": index === 0 }} set:text={paragraph} />)}
  </div>
</div>

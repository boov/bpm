---
import Button from "@components/Button.astro";
import Input from "@components/Input.astro";
import ExternalLink from "@lucide/astro/icons/external-link";

const TEST_PAYMENT_URL = "https://buy.stripe.com/test_7sY4gBddRbov0mMf229EI00";
const stripePaymentUrl = import.meta.env.STRIPE_PAYMENT_URL || TEST_PAYMENT_URL;

if (!import.meta.env.STRIPE_PAYMENT_URL) {
  if (import.meta.env.PROD && process.env.CONTEXT === "production") {
    throw new Error("STRIPE_PAYMENT_URL is not set. Production builds must use the live Stripe Payment Link. See apps/web/.env.example.");
  }
  console.warn("STRIPE_PAYMENT_URL is not set; falling back to the Stripe test link. See apps/web/.env.example.");
}
---

<div x-data="paymentForm()" class="flex flex-col gap-6 md:gap-8">
  <form class="flex flex-col gap-6 md:gap-8" method="get" action={stripePaymentUrl} target="_blank">
    <input type="hidden" name="__prefilled_amount" x-bind:value="formatAmount()" />
    <div class="grid gap-1">
      <label for="amount">Amount to pay (&pound;)</label>
      <div class="relative">
        <span class="text-theme-foreground-light pointer-events-none absolute top-1/2 left-6 -translate-y-1/2 text-3xl md:text-5xl">&pound;</span>
        <Input
          id="amount"
          name=""
          x-model="amount"
          class="pl-12 text-3xl md:text-5xl"
          inputmode="decimal"
          type="number"
          step="0.01"
          min="1"
          required
          data-error="Enter the amount to pay, for example 250.50"
        />
      </div>
    </div>
    <div class="grid gap-1">
      <label for="prefilled_email">Email address</label>
      <Input
        id="prefilled_email"
        aria-describedby="prefilled_email_hint"
        x-model="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        required
        data-error="Enter your email address, for example name@example.com"
      />
      <p id="prefilled_email_hint" class="text-theme-foreground-light text-sm">Used for your payment confirmation</p>
    </div>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
      <Button label="Pay your service charge" type="submit" class="px-7 py-5 text-base" target="_blank">
        <ExternalLink slot="suffix" />
      </Button>
      <div class="flex flex-col gap-0.5 text-xs">
        <p>Payments by Stripe</p>
        <svg aria-hidden="true" width="61" height="25" viewBox="0 0 61 25" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"

---
import Heading from "@components/Heading.astro";
import InlineText from "@components/sections/InlineText.astro";
import Check from "@lucide/astro/icons/check";

interface Props {
  heading: string;
  items: string[];
}

const { heading, items } = Astro.props;
---

<div class="container">
  <div class="flex flex-col gap-8">
    <Heading as="h2" class="text-h4 sm:text-h3 border-b-theme-border border-b pb-2" set:text={heading} />
    <ul class="grid gap-10 md:grid-cols-2 lg:grid-cols-3">
      {
        items.map(item => {
          return (
            <li class="border-theme-border-light flex items-start gap-4">
              <span class="bg-theme-brand/15 text-theme-brand-lowlight flex size-7 shrink-0 items-center justify-center rounded-full" aria-hidden="true">
                <Check class="size-3 stroke-3" />
              </span>
              <InlineText as="span" text={item} class="text-theme-foreground-bold font-bold" />
            </li>
          );
        })
      }
    </ul>
  </div>
</div>

---
import logoMark from "@assets/images/logo-mark.svg?raw";
import TrustStrip from "@components/global/TrustStrip.astro";
import Heading from "@components/Heading.astro";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  eyebrow: string;
  heading: string;
  lead: string;
  note?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, heading, lead, note, image, imageAlt = "" } = Astro.props;
---

<div class="container">
  <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between lg:gap-20 xl:gap-40">
    <div class="lg:max-w-6c flex flex-col gap-2 md:gap-3">
      <div class="flex items-center gap-5">
        <p class="subheading text-theme-action">{eyebrow}</p>
        <div class="bg-theme-action h-0.5 w-20 rounded sm:w-24"></div>
      </div>
      <Heading as="h1" class="text-h2 sm:text-h1 md:text-h0">{heading}</Heading>
    </div>
    <div class="flex flex-col items-start gap-5 lg:max-w-[60ch] lg:flex-1">
      <p class="text-lg sm:text-balance xl:text-xl">{lead}</p>
      {note && <p class="text-sm" set:text={note} />}
    </div>
  </div>
</div>
{
  image && (
    <div class="container-13c">
      <div class="scoop relative z-20 overflow-hidden rounded-xl sm:rounded-2xl md:rounded-3xl">
        <div class="theme-dark relative overflow-hidden">
          <Image src={image} alt={imageAlt} width={1536} height={658} densities={[1, 2]} class="aspect-ultrawide w-full object-cover" />
          <div
            class="text-theme-foreground-bold pointer-events-none absolute right-0 bottom-0 z-20 hidden w-90 translate-1/6 -scale-x-100 opacity-40 lg:block xl:w-120"
            aria-hidden="true"
            set:html={logoMark}
          />
        </div>
        <TrustStrip />
      </div>
    </div>
  )
}

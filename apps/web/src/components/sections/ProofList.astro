---
import logoMark from "@assets/images/logo-mark.svg?raw";
import Heading from "@components/Heading.astro";
import InlineText from "@components/sections/InlineText.astro";
import Check from "@lucide/astro/icons/check";

interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<div class="container-13c">
  <div class="theme-dark scoop bg-theme-background-lowlight relative overflow-hidden rounded-xl sm:rounded-2xl md:rounded-3xl">
    <div class="relative z-20 grid gap-10 p-8 sm:p-12 md:p-14 lg:grid-cols-[5fr_11fr] lg:gap-14 2xl:p-24">
      <div class="flex flex-col gap-5">
        <div class="bg-theme-brand h-[2px] w-12 rounded"></div>
        <Heading as="h2" class="text-h3 md:text-h2">Why choose Belgarum Property Management?</Heading>
      </div>
      <ul class="grid gap-x-10 sm:grid-cols-2">
        {
          items.map(item => (
            <li class="border-theme-border flex items-start gap-4 border-t py-5">
              <span class="bg-theme-brand text-theme-background-lowlight grid size-7 shrink-0 place-items-center rounded-full" aria-hidden="true">
                <Check class="size-4 stroke-3" />
              </span>
              <InlineText as="span" text={item} class="text-theme-foreground-bold font-bold" />
            </li>
          ))
        }
      </ul>
    </div>
    <div
      class="text-theme-foreground pointer-events-none absolute bottom-0 left-0 z-10 hidden w-60 -translate-x-1/6 translate-y-1/6 opacity-10 lg:block xl:w-72"
      aria-hidden="true"
      set:html={logoMark}
    />
  </div>
</div>

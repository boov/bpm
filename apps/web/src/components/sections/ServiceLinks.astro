---
import ServicesGrid from "@components/collection/service/ServicesGrid.astro";
import Heading from "@components/Heading.astro";

interface Props {
  heading: string;
  ids: string[];
}

const { heading, ids } = Astro.props;
---

<div class="container">
  <div class="flex flex-col gap-8">
    <div class="lg:max-w-8c flex flex-col gap-2 md:gap-3">
      <div class="flex items-center gap-5">
        <p class="subheading text-theme-action">Our Services</p>
        <div class="bg-theme-action h-0.5 w-20 rounded sm:w-24"></div>
      </div>
      <Heading as="h2" class="text-h4 sm:text-h3 md:text-h2" set:text={heading} />
    </div>
    <ServicesGrid {ids} />
  </div>
</div>

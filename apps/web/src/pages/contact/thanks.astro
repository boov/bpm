---
import { site } from "@assets/scripts/site";
import Button from "@components/Button.astro";
import Trim from "@components/global/Trim.astro";
import Heading from "@components/Heading.astro";
import Section from "@components/Section.astro";
import SocialLinks from "@components/SocialLinks.astro";
import Default from "@layouts/Default.astro";
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import MailCheck from "@lucide/astro/icons/mail-check";

const title = "Thank you for your enquiry";
const description = "We've received your enquiry and we'll reply within 5 working days.";
const links = [
  { label: "Head back home", href: "/", icon: ArrowLeft },
  { label: "Read our FAQs", href: "/faqs/" },
  { label: "Learn about us", href: "/about/" }
];
---

<Default title={title} description={description} allowIndexing={false} centered>
  <Section>
    <div class="container-6c">
      <div class="flex flex-col items-center gap-8 text-center lg:gap-10">
        <MailCheck class="text-positive-500 size-14 stroke-[1.5] lg:size-18" />
        <div class="flex flex-col items-center gap-4">
          <Heading as="h1" class="text-h3 md:text-h2 lg:text-h1">{title}</Heading>
          <p class="text-lg">We've received your enquiry and we'll reply within 5 working days. Our office is open {site.hours}.</p>
          <p>If your enquiry is urgent, call us on <a href={site.phoneHref} class="link">{site.phone}</a>.</p>
        </div>
        <div class="flex flex-wrap justify-center gap-x-8 gap-y-2">
          {
            links.map(({ label, href, icon: Icon }) => (
              <Button label={label} href={href} variant="text">
                {Icon && <Icon slot="prefix" />}
              </Button>
            ))
          }
        </div>
        <div class="bg-theme-background-lowlight flex flex-col items-center gap-4 rounded-2xl p-8 sm:flex-row sm:gap-12 lg:gap-20">
          <Heading as="p" class="text-h5">Find us elsewhere</Heading>
          <SocialLinks />
        </div>
      </div>
    </div>
  </Section>
  <Fragment slot="footer">
    <footer id="p_footer-group">
      <Trim />
    </footer>
  </Fragment>
</Default>

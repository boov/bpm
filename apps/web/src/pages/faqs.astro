---
import QuestionGroup from "@components/collection/question/QuestionGroup.astro";
import Heading from "@components/Heading.astro";
import Section from "@components/Section.astro";
import { getQuestions, getQuestionsByGroup } from "@helpers";
import Default from "@layouts/Default.astro";

const questionGroups = await getQuestionsByGroup();
const questions = await getQuestions();

const title = "Frequently asked questions";
const description = "";

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.map(question => ({
    "@type": "Question",
    name: question.data.title,
    acceptedAnswer: {
      "@type": "Answer",
      text: question.data.answer.join("\n\n")
    }
  }))
});
---

<Default title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={faqSchema} />
  </Fragment>
  <Section>
    <div class="container-8c">
      <div class="flex flex-col gap-12 md:gap-16">
        <Heading as="h1" class="text-h3 sm:text-h2 md:text-h1" set:text={title} />
        {questionGroups.map(([groupName, questions]) => <QuestionGroup title={groupName} questions={questions} />)}
      </div>
    </div>
  </Section>
</Default>

---
import { faqPageSchema } from "@assets/scripts/faq-schema";
import { toJsonLd } from "@assets/scripts/json-ld";
import QuestionGroup from "@components/collection/question/QuestionGroup.astro";
import Heading from "@components/Heading.astro";
import Section from "@components/Section.astro";
import { getAudiences, getQuestions, getQuestionsByGroup, getServices } from "@helpers";
import Default from "@layouts/Default.astro";

const questionGroups = await getQuestionsByGroup();
const questions = await getQuestions();

const title = "Leaseholder and RMC FAQs";
const description = "Answers for leaseholders and directors: paying your service charge, why it goes up, repairs, Section 20, major works and selling your flat.";

// Google wants FAQ markup on one page only, so questions already marked up on a topic page stay out of this page's schema.
const normalise = (text: string) => text.replace(/[‘’]/g, "'").replace(/\s+/g, " ").trim().toLowerCase();
const topicPages = [...(await getServices()), ...(await getAudiences())];
const topicQuestions = new Set(topicPages.flatMap(page => page.data.faqs.map(faq => normalise(faq.question))));
const schemaQuestions = questions.filter(q => !topicQuestions.has(normalise(q.data.title)));

const faqSchema = toJsonLd(faqPageSchema(schemaQuestions.map(q => ({ question: q.data.title, answer: q.data.answer }))));
---

<Default title={title} description={description} cta="residents">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={faqSchema} />
  </Fragment>
  <Section>
    <div class="container-8c">
      <div class="flex flex-col gap-12 md:gap-16">
        <div class="flex flex-col gap-4">
          <Heading as="h1" class="text-h3 sm:text-h2 md:text-h1" set:text="Frequently asked questions" />
          <p class="text-lg text-balance">{description}</p>
        </div>
        {questionGroups.map(([groupName, questions]) => <QuestionGroup title={groupName} questions={questions} />)}
      </div>
    </div>
  </Section>
</Default>

---
import { site } from "@assets/scripts/site";
import Trim from "@components/global/Trim.astro";
import Heading from "@components/Heading.astro";
import PaymentForm from "@components/pages/pay-online/PaymentForm.astro";
import Section from "@components/Section.astro";
import Default from "@layouts/Default.astro";

const title = "Pay your service charge";
const description = "Pay your service charge to Belgarum Property Management online by debit or credit card. Stripe takes your payment securely.";
const steps = [
  "Enter the amount you want to pay. Use the amount on your service charge demand.",
  "Enter your email address.",
  'Select "Pay your service charge". A secure Stripe payment page opens in a new tab.',
  "Enter your card details on the Stripe page to complete the payment."
];
---

<Default title={title} description={description}>
  <Section>
    <div class="container-6c">
      <div class="flex flex-col gap-10 sm:gap-12 md:gap-14 lg:gap-16">
        <div class="flex flex-col gap-6">
          <Heading as="h1" class="text-h2 sm:text-h1">{title}</Heading>
          <p class="text-lg">Pay online by debit or credit card. Stripe takes your payment securely.</p>
          <ol class="flex list-decimal flex-col gap-1 pl-6 text-sm">
            {steps.map(step => <li>{step}</li>)}
          </ol>
        </div>
        <PaymentForm />
        <div class="bg-theme-background-lowlight flex flex-col items-start gap-2 rounded-2xl p-8 text-sm">
          <Heading as="h2" class="text-h5">Questions about your service charge?</Heading>
          <p>
            If you're not sure how much to pay, or you think your demand is wrong, contact your property manager before you pay. Call <a href={site.phoneHref} class="link"
              >{site.phone}</a
            > or email <a href={`mailto:${site.email}`} class="link">{site.email}</a>.
          </p>
        </div>
      </div>
    </div>
  </Section>
  <Fragment slot="footer">
    <footer id="p_footer-group">
      <Trim />
    </footer>
  </Fragment>
</Default>

---
import { site } from "@assets/scripts/site";
import Trim from "@components/global/Trim.astro";
import Heading from "@components/Heading.astro";
import PaymentForm from "@components/pages/pay-online/PaymentForm.astro";
import Section from "@components/Section.astro";
import InlineText from "@components/sections/InlineText.astro";
import Default from "@layouts/Default.astro";

const title = "Pay your service charge";
const description = "Pay your service charge to Belgarum Property Management online by debit or credit card. Stripe takes your payment securely.";
const steps = [
  "Enter the amount you want to pay. Use the amount on your service charge demand.",
  "Enter your email address.",
  'Select "Pay your service charge". A secure Stripe payment page opens in a new tab.',
  "Enter your card details on the Stripe page to complete the payment."
];
---

<Default title={title} description={description}>
  <Section>
    <div class="container-6c">
      <div class="flex flex-col gap-10 sm:gap-12 md:gap-14 lg:gap-16">
        <div class="flex flex-col gap-8">
          <Heading as="h1" class="text-h2 sm:text-h1 text-balance">{title}</Heading>
          <p>Pay online by debit or credit card. Stripe takes your payment securely.</p>
          <div class="flex flex-col gap-4">
            <Heading as="h2" class="text-h4">How to pay</Heading>
            <ol class="flex list-decimal flex-col gap-2 pl-6">
              {steps.map(step => <li>{step}</li>)}
            </ol>
          </div>
        </div>
        <PaymentForm />
        <div class="flex flex-col gap-4">
          <Heading as="h2" class="text-h4">Questions about your demand?</Heading>
          <InlineText
            text={`If you're not sure how much to pay, or you think your demand is wrong, contact your property manager before you pay. Call [${site.phone}](${site.phoneHref}) or email [${site.email}](mailto:${site.email}).`}
          />
        </div>
      </div>
    </div>
  </Section>
  <Fragment slot="footer">
    <footer id="p_footer-group">
      <Trim />
    </footer>
  </Fragment>
</Default>

---
import { site } from "@assets/scripts/site";
import Button from "@components/Button.astro";
import Trim from "@components/global/Trim.astro";
import Heading from "@components/Heading.astro";
import Section from "@components/Section.astro";
import Default from "@layouts/Default.astro";
import CircleX from "@lucide/astro/icons/circle-x";
import Phone from "@lucide/astro/icons/phone";
import RefreshCw from "@lucide/astro/icons/refresh-cw";

const title = "Payment not completed";
const description = "Your payment wasn't completed. You can try again, or contact us if you need help.";
---

<Default title={title} description={description} allowIndexing={false}>
  <Section>
    <div class="container-6c">
      <div class="flex flex-col items-center gap-6 text-center">
        <CircleX class="text-negative size-16" />
        <Heading as="h1" class="text-h2" set:text={title} />
        <p class="text-lg">Your payment wasn't completed. You can try again, or use a different card.</p>
        <p>If money has left your account, contact your property manager on <a href={site.phoneHref} class="link">{site.phone}</a> before you try again.</p>
        <div class="flex flex-col gap-4 sm:flex-row">
          <Button label="Try again" href="/pay-online/" variant="solid">
            <RefreshCw slot="suffix" />
          </Button>
          <Button label="Contact your property manager" href="/contact/" variant="outline">
            <Phone slot="suffix" />
          </Button>
        </div>
      </div>
    </div>
  </Section>
  <Fragment slot="footer">
    <footer id="p_footer-group">
      <Trim />
    </footer>
  </Fragment>
</Default>

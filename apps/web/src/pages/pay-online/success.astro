---
import { site } from "@assets/scripts/site";
import Button from "@components/Button.astro";
import Trim from "@components/global/Trim.astro";
import Heading from "@components/Heading.astro";
import Section from "@components/Section.astro";
import Default from "@layouts/Default.astro";
import CircleCheck from "@lucide/astro/icons/circle-check";
import CreditCard from "@lucide/astro/icons/credit-card";
import House from "@lucide/astro/icons/house";

const title = "Payment complete";
const description = "Thank you. Your service charge payment is complete.";
---

<Default title={title} description={description} allowIndexing={false} centered>
  <Section>
    <div class="container-6c">
      <div class="flex flex-col items-center gap-6 text-center">
        <CircleCheck class="text-positive size-16" />
        <Heading as="h1" class="text-h2" set:text={title} />
        <p class="text-lg" set:text={description} />
        <p class="text-balance">
          If you have a question about your payment, contact your property manager on <a href={site.phoneHref} class="link whitespace-nowrap">{site.phone}</a>.
        </p>
        <div class="flex flex-col gap-4 sm:flex-row">
          <Button label="Go to the home page" href="/" variant="solid">
            <House slot="suffix" />
          </Button>
          <Button label="Make another payment" href="/pay-online/" variant="outline">
            <CreditCard slot="suffix" />
          </Button>
        </div>
      </div>
    </div>
  </Section>
  <Fragment slot="footer">
    <footer id="p_footer-group">
      <Trim />
    </footer>
  </Fragment>
</Default>

---
import ServicesGrid from "@components/collection/service/ServicesGrid.astro";
import ServicesIntro from "@components/collection/service/ServicesIntro.astro";
import Section from "@components/Section.astro";
import Default from "@layouts/Default.astro";

const title = "Our services";
const description = "Tailored management strategies for every property challenge";
---

<Default title={title} description={description}>
  <Section>
    <div class="container">
      <div class="flex flex-col gap-16 sm:gap-20 md:gap-24 lg:gap-28">
        <ServicesIntro as="h1" />
        <ServicesGrid />
      </div>
    </div>
  </Section>
</Default>

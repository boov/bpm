{
  "extends": ["astro/tsconfigs/base", "../../tsconfig.base.json"],
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "scripts"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@helpers": ["src/assets/scripts/helpers.ts"],
      "@types": ["src/types.ts"],
      "@assets/*": ["src/assets/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"]
    }
  }
}

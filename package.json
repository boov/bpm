{
  "name": "bpm",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@bpm/$(cat .active-app 2>/dev/null || echo web) --if-present",
    "build": "npm run build --workspace=@bpm/$(cat .active-app 2>/dev/null || echo web) --if-present",
    "preview": "npm run preview --workspace=@bpm/$(cat .active-app 2>/dev/null || echo web) --if-present",
    "build:all": "npm run build --workspaces --if-present",
    "clean": "rm -rf apps/*/dist apps/*/.astro apps/*/.netlify .eslintcache",
    "eslint": "eslint . --cache --fix",
    "prettier": "prettier -lw .",
    "format": "npm run prettier && npm run eslint"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "browserslist": [
    "last 4 years and not dead"
  ],
  "dependencies": {
    "@alpinejs/collapse": "^3.15.12",
    "@astrojs/sitemap": "^3.7.2",
    "@bpm/custom-merge": "workspace:*",
    "@bpm/design-system": "workspace:*",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@lucide/astro": "^1.14.0",
    "@netlify/plugin-lighthouse": "^6.0.4",
    "@tailwindcss/vite": "^4.2.4",
    "alpinejs": "^3.15.12",
    "astro": "6.2.2",
    "astro-compress": "^2.4.1",
    "astro-meta-tags": "^0.4.1",
    "lodash": "^4.18.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "eslint": "^10.3.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "typescript-eslint": "^8.59.2"
  },
  "overrides": {
    "vite": "^7.3.2"
  }
}

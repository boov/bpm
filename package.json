{
  "name": "bpm",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm --filter @bpm/$(cat .active-app 2>/dev/null || echo web) run --if-present dev",
    "build": "pnpm --filter @bpm/$(cat .active-app 2>/dev/null || echo web) run --if-present build",
    "preview": "pnpm --filter @bpm/$(cat .active-app 2>/dev/null || echo web) run --if-present preview",
    "build:all": "pnpm -r run --if-present build",
    "clean": "rm -rf apps/*/dist apps/*/.astro apps/*/.netlify .eslintcache",
    "eslint": "eslint . --cache --fix",
    "prettier": "prettier -lw .",
    "format": "pnpm prettier && pnpm eslint"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "browserslist": [
    "last 4 years and not dead"
  ],
  "devDependencies": {
    "eslint": "catalog:",
    "eslint-plugin-astro": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-astro": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
